# Copy to .env and fill in real values (.env is gitignored; never commit it).
# Load it with: set -a; source .env; set +a

# '0' = local MongoDB (default), '1' = cloud, using MONGO_URI
CLOUD_MONGO='0'

# Cloud connection string from MongoDB Atlas.
# Keep the single quotes: the string contains & and ?
MONGO_URI='mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority'
